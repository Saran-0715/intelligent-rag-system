# ============================================================
# Intelligent RAG System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# --- LLM Provider ---
# Get a free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# LLM model to use (Groq provides fast, free inference)
# Options: llama-3.1-8b-instant | llama-3.1-70b-versatile | mixtral-8x7b-32768
LLM_MODEL=llama-3.1-8b-instant

# LLM provider: "groq" (default) | "none" (retrieval-only mode)
LLM_PROVIDER=groq

# --- Embedding Model ---
# Local model — no API key needed. Downloads once, ~90MB.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/rag_system.db

# --- Vector Store ---
CHROMA_DB_PATH=./data/chroma_db

# --- File Upload ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=true

# --- CORS (comma-separated origins) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
