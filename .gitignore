# ============================================================
# Intelligent RAG System — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# --- Virtual Environments ---
venv/
.venv/
env/
.env/

# --- SECRETS — NEVER COMMIT ---
.env
*.env.local
*.key

# --- Uploaded Files & Local Databases (never commit) ---
data/uploads/
data/chroma_db/
data/rag_system.db
backend/data/
**/chroma_db/
**/uploads/
*.db
*.sqlite
*.sqlite3

# --- Frontend ---
frontend/node_modules/
frontend/dist/

# --- IDE ---
.vscode/settings.json
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
